# Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK=http://localhost:4174/api/auth/google/callback
FRONTEND_URL=http://192.168.100.92:4173

# Public API URL used by the deployed frontend, for example:
# https://health-link-api.onrender.com
VITE_API_URL=

# Generate unique random values for hosted environments
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Use a long random value outside local development
SESSION_SECRET=replace-with-a-random-session-secret
PORT=4174
